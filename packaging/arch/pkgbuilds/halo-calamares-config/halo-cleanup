#!/usr/bin/bash
# Runs inside the newly installed system (Calamares shellprocess@halo-cleanup, before initcpio and
# the boot loader): removes what only the live ISO needs and gives the system Arch's normal setup.
set -u
log() { echo "halo-cleanup: $*"; }

# Live-only units and files from the image (they're inert outside the live ISO, but don't belong here).
for u in halo-live.service halo-pacman-init.service; do
  systemctl disable "$u" 2>/dev/null
  rm -f "/etc/systemd/system/$u"
done
rm -rf /usr/local/lib/halo
rm -f /etc/mkinitcpio.conf.d/halo-live.conf

# Arch's default kernel preset (the image had an archiso-only one).
cat > /etc/mkinitcpio.d/linux.preset <<'EOF'
# mkinitcpio preset file for the 'linux' package

ALL_kver="/boot/vmlinuz-linux"

PRESETS=('default' 'fallback')

default_image="/boot/initramfs-linux.img"

fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
EOF

# A working mirror and the installed system's own pacman keyring.
grep -q '^Server' /etc/pacman.d/mirrorlist 2>/dev/null \
  || echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' >> /etc/pacman.d/mirrorlist
pacman-key --init >/dev/null 2>&1 && pacman-key --populate archlinux >/dev/null 2>&1 || log "pacman keyring setup failed"

# The live ISO's tools. Last: this removes the package this script came from (it keeps running).
pacman -Rns --noconfirm mkinitcpio-archiso halo-calamares-config calamares >/dev/null 2>&1 || log "removing live packages failed"
exit 0
