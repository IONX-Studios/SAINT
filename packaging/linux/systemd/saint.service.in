# SAINT as a per-user service in the Plasma session (no root).
#   systemctl --user start|stop|restart|status saint
#   journalctl --user -u saint -f
[Unit]
Description=SAINT assistant
PartOf=graphical-session.target
After=graphical-session.target pipewire.service
# A crash loop must not hammer the machine: give up after 5 failures in 2 minutes.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@SAINT_ROOT@/run.sh --background
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
