{$HALO_DOMAIN} {
	encode gzip
	reverse_proxy relay:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$HALO_DOMAIN}; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self'; script-src 'self'"
	}
}
